# Copy to .env and fill in. Never commit .env.
# Supabase: "Connect" button -> Session pooler (works on IPv4). PROJECT_REF and REGION are in that string.

# Owner connection (user `postgres`). Used only by `python -m db.migrate`.
DATABASE_URL_ADMIN=postgresql://postgres.PROJECT_REF:CHANGE_ME@aws-0-REGION.pooler.supabase.com:5432/postgres

# Seed script and admin page. Login user created in step 4 of docs/supabase-setup.md.
DATABASE_URL_WRITE=postgresql://vl_writer.PROJECT_REF:CHANGE_ME@aws-0-REGION.pooler.supabase.com:5432/postgres

# Public Streamlit app (read-only).
DATABASE_URL_READ=postgresql://vl_reader.PROJECT_REF:CHANGE_ME@aws-0-REGION.pooler.supabase.com:5432/postgres

ADMIN_PASSWORD=CHANGE_ME

# Signs the admin login cookie. Any long random string.
SESSION_SECRET=CHANGE_ME
