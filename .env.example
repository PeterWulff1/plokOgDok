# Copy to .env and fill in. Never commit .env.
# Supabase: "Connect" button -> Session pooler (works on IPv4). PROJECT_REF and REGION are in that string.

# Owner connection (user `postgres`). Used only by `python -m db.migrate`.
DATABASE_URL_ADMIN=postgresql://postgres.PROJECT_REF:CHANGE_ME@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require

# Seed script and admin page. Login user created in step 4 of docs/supabase-setup.md.
DATABASE_URL_WRITE=postgresql://vl_writer.PROJECT_REF:CHANGE_ME@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require

# Public Streamlit app (read-only).
DATABASE_URL_READ=postgresql://vl_reader.PROJECT_REF:CHANGE_ME@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require

# Optional: calendar sync only (step 5 of docs/supabase-setup.md). The GitHub workflow has
# this as a secret. Without it, the sync falls back to DATABASE_URL_WRITE.
# DATABASE_URL_CALENDAR=postgresql://vl_calendar_sync.PROJECT_REF:CHANGE_ME@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require

ADMIN_PASSWORD=CHANGE_ME

# Signs the admin login cookie. Any long random string.
SESSION_SECRET=CHANGE_ME

# Only if the app is ever hosted (it runs locally today):
# ALLOWED_HOSTS=example.dk,www.example.dk   # Host headers the app answers to (default: 127.0.0.1,localhost)
# HTTPS_ONLY=1                              # send the login cookie over HTTPS only
